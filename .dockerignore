# Allow only application source and reproducibility inputs into the build.
**
!Dockerfile
!.dockerignore
!.gitignore
!.github/
!.github/dependabot.yml
!.github/workflows/
!.github/workflows/*.yml
!pyproject.toml
!uv.lock
!.python-version
!README.md
!catalog/
!catalog/*.json
!docs/
!docs/*.md
!src/
!src/*.py
!scripts/
!scripts/*.py
!tests/
!tests/*.py
!freeze_splits.py
!train_pipeline.py
!train_deep_pipeline.py
!summarize_results.py
!plot_mc_dropout_uncertainty.py
