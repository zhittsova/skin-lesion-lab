{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skin Lesion Lab normalized cohort row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "isic_id",
    "lesion_id",
    "dx",
    "target",
    "image_sha256",
    "patient_id",
    "duplicate_cluster_id"
  ],
  "properties": {
    "isic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "lesion_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "dx": {
      "type": "string",
      "enum": [
        "mel",
        "nv",
        "bkl",
        "df",
        "vasc"
      ]
    },
    "target": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patient_id": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "duplicate_cluster_id": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_-]*$"
    }
  }
}
